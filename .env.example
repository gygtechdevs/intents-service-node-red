# intents-service configuration
PORT=4002

# Same Postgres instance as auth-service / platform (local: port 5434, db platform_db).
# The runner uses its own control table: schema_migrations_intents.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/platform_db

# HS256 secret shared with auth-service (its JWT_SECRET). Verified locally.
AUTH_JWT_SECRET=change-me

# Shared with the api-gateway (INTENTS_INTERNAL_SECRET). Required by
# POST /intents/detect and GET /internal/intents.
INTERNAL_SECRET=change-me

# Set to true when the database requires TLS.
PG_SSL=false

# Comma-separated browser origins allowed to call this service with credentials.
# Empty = no browser origin allowed (the gateway is a non-browser client and is
# unaffected). A literal "*" is served WITHOUT credentials.
CORS_ALLOWED_ORIGINS=

# --- Unmatched message capture (opt-in) ---
# Stores PII-masked text of messages with no intent match for admin review and
# mounts the /admin/unmatched routes. Requires migration 004.
UNMATCHED_CAPTURE_ENABLED=false
UNMATCHED_MAX_LENGTH=500
UNMATCHED_RETENTION_DAYS=30

# --- Semantic detection (opt-in; Amazon Bedrock + pgvector) ---
# Requires migration 005 (Postgres with the pgvector extension) and AWS
# credentials from the default provider chain (profile, SSO or role).
# AWS_REGION is mandatory when SEMANTIC_ENABLED=true.
SEMANTIC_ENABLED=false
DISAMBIGUATION_ENABLED=true
AWS_REGION=us-east-1
# AWS credentials (local dev). Read by the AWS SDK default provider chain; never
# commit real values. Leave empty to use AWS_PROFILE or an IAM role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (SSO / STS):
AWS_SESSION_TOKEN=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_DISAMBIGUATOR_MODEL_ID=amazon.nova-micro-v1:0
# Untuned defaults, see the tuning section in the README.
SEMANTIC_MIN_SIMILARITY=0.80
SEMANTIC_AMBIGUITY_MARGIN=0.05
SEMANTIC_TOP_K=5
SEMANTIC_BUDGET_MS=1500
BEDROCK_EMBED_TIMEOUT_MS=800
BEDROCK_LLM_TIMEOUT_MS=1000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000
